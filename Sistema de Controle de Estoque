        "import json\n",
        "import os\n",
        "\n",
        "ARQUIVO_ESTOQUE = \"estoque.json\"\n",
        "\n",
        "\n",
        "def carregar_estoque():\n",
        "    \"\"\"Carrega os produtos do arquivo JSON se ele existir.\"\"\"\n",
        "    if os.path.exists(ARQUIVO_ESTOQUE):\n",
        "        try:\n",
        "            with open(ARQUIVO_ESTOQUE, \"r\", encoding=\"utf-8\") as f:\n",
        "                return json.load(f)\n",
        "        except json.JSONDecodeError:\n",
        "            return {}\n",
        "    return {}\n",
        "\n",
        "\n",
        "def salvar_estoque(estoque):\n",
        "    \"\"\"Salva o estado atual do estoque no arquivo JSON.\"\"\"\n",
        "    with open(ARQUIVO_ESTOQUE, \"w\", encoding=\"utf-8\") as f:\n",
        "        json.dump(estoque, f, ensure_ascii=False, indent=4)\n",
        "\n",
        "\n",
        "def cadastrar_produto(estoque):\n",
        "    print(\"\\n--- CADASTRAR PRODUTO ---\")\n",
        "    nome = input(\"Nome do produto: \").strip().capitalize()\n",
        "\n",
        "    if nome in estoque:\n",
        "        print(\"Erro: Produto já cadastrado!\")\n",
        "        return\n",
        "\n",
        "    try:\n",
        "        quantidade = int(input(\"Quantidade inicial: \"))\n",
        "        preco = float(input(\"Preço unitário: R$ \"))\n",
        "\n",
        "        if quantidade < 0 or preco < 0:\n",
        "            print(\"Valores não podem ser negativos.\")\n",
        "            return\n",
        "\n",
        "        estoque[nome] = {\"quantidade\": quantidade, \"preco\": preco}\n",
        "        salvar_estoque(estoque)\n",
        "        print(f\"Produto '{nome}' cadastrado com sucesso!\")\n",
        "    except ValueError:\n",
        "        print(\"Erro: Digite apenas números válidos para quantidade e preço.\")\n",
        "\n",
        "\n",
        "def remover_produto(estoque):\n",
        "    print(\"\\n--- REMOVER PRODUTO ---\")\n",
        "    nome = input(\"Nome do produto a remover: \").strip().capitalize()\n",
        "\n",
        "    if nome in estoque:\n",
        "        del estoque[nome]\n",
        "        salvar_estoque(estoque)\n",
        "        print(f\"Produto '{nome}' removido do estoque!\")\n",
        "    else:\n",
        "        print(\"Produto não encontrado.\")\n",
        "\n",
        "\n",
        "def alterar_quantidade(estoque):\n",
        "    print(\"\\n--- ALTERAR QUANTIDADE ---\")\n",
        "    nome = input(\"Nome do produto: \").strip().capitalize()\n",
        "\n",
        "    if nome not in estoque:\n",
        "        print(\"Produto não encontrado.\")\n",
        "        return\n",
        "\n",
        "    try:\n",
        "        nova_qtd = int(\n",
        "            input(\n",
        "                f\"Quantidade atual de '{nome}': {estoque[nome]['quantidade']}\\nDigite a nova quantidade: \"\n",
        "            )\n",
        "        )\n",
        "        if nova_qtd < 0:\n",
        "            print(\"A quantidade não pode ser negativa.\")\n",
        "            return\n",
        "\n",
        "        estoque[nome][\"quantidade\"] = nova_qtd\n",
        "        salvar_estoque(estoque)\n",
        "        print(\"Quantidade atualizada com sucesso!\")\n",
        "    except ValueError:\n",
        "        print(\"Erro: Digite um número inteiro válido.\")\n",
        "\n",
        "\n",
        "def listar_produtos(estoque):\n",
        "    print(\"\\n--- LISTA DE PRODUTOS ---\")\n",
        "    if not estoque:\n",
        "        print(\"O estoque está vazio.\")\n",
        "        return\n",
        "\n",
        "    print(\"-\" * 50)\n",
        "    print(f\"{'PRODUTO':<20} | {'QUANTIDADE':<10} | {'PREÇO (R$)':<10}\")\n",
        "    print(\"-\" * 50)\n",
        "    for nome, dados in estoque.items():\n",
        "        print(\n",
        "            f\"{nome:<20} | {dados['quantidade']:<10} | R$ {dados['preco']:.2f}\"\n",
        "        )\n",
        "    print(\"-\" * 50)\n",
        "\n",
        "\n",
        "def consultar_produto(estoque):\n",
        "    print(\"\\n--- CONSULTAR PRODUTO ---\")\n",
        "    nome = input(\"Nome do produto: \").strip().capitalize()\n",
        "\n",
        "    if nome in estoque:\n",
        "        p = estoque[nome]\n",
        "        print(f\"\\nProduto: {nome}\")\n",
        "        print(f\"Quantidade em estoque: {p['quantidade']}\")\n",
        "        print(f\"Preço unitário: R$ {p['preco']:.2f}\")\n",
        "        print(f\"Valor total em estoque: R$ {p['quantidade'] * p['preco']:.2f}\")\n",
        "    else:\n",
        "        print(\"Produto não encontrado no sistema.\")\n",
        "\n",
        "\n",
        "def menu():\n",
        "    estoque = carregar_estoque()\n",
        "\n",
        "    while True:\n",
        "        print(\"\\n===== ESTOQUE =====\")\n",
        "        print(\"1 - Cadastrar produto\")\n",
        "        print(\"2 - Remover produto\")\n",
        "        print(\"3 - Alterar quantidade\")\n",
        "        print(\"4 - Listar produtos\")\n",
        "        print(\"5 - Consultar produto\")\n",
        "        print(\"0 - Sair\")\n",
        "\n",
        "        opcao = input(\"Escolha uma opção: \").strip()\n",
        "\n",
        "        if opcao == \"1\":\n",
        "            cadastrar_produto(estoque)\n",
        "        elif opcao == \"2\":\n",
        "            remover_produto(estoque)\n",
        "        elif opcao == \"3\":\n",
        "            alterar_quantidade(estoque)\n",
        "        elif opcao == \"4\":\n",
        "            listar_produtos(estoque)\n",
        "        elif opcao == \"5\":\n",
        "            consultar_produto(estoque)\n",
        "        elif opcao == \"0\":\n",
        "            print(\"Encerrando o sistema de estoque. Até mais!\")\n",
        "            break\n",
        "        else:\n",
        "            print(\"Opção inválida! Tente novamente.\")\n",
        "\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    menu()"
      ]
    }
